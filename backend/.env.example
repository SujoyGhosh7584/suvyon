# ==========================================================
# Suvyon Environment Configuration
# ==========================================================

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------

APP_NAME=Suvyon
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=False

# ----------------------------------------------------------
# API
# ----------------------------------------------------------

API_V1_PREFIX=/api/v1

# ----------------------------------------------------------
# Security
# ----------------------------------------------------------

SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_SECRET

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------

# Local: postgresql://user:pass@localhost:5432/suvyon
# Supabase (Session pooler, port 5432) or Transaction pooler (6543):
# postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://username:password@localhost:5432/suvyon

# ----------------------------------------------------------
# Supabase
# ----------------------------------------------------------

SUPABASE_URL=https://your-project.supabase.co

SUPABASE_KEY=your_supabase_anon_or_service_key

# ----------------------------------------------------------
# AI Providers
# ----------------------------------------------------------

OPENROUTER_API_KEY=

GROQ_API_KEY=

GEMINI_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
HUGGINGFACE_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
NVIDIA_API_KEY=
# Generate a long random value once and keep it stable across deployments.
CREDENTIAL_ENCRYPTION_KEY=

# Reject every model whose declared input or output price is above zero.
ZERO_COST_MODE=true

# ----------------------------------------------------------
# Social login and GitHub projects
# ----------------------------------------------------------

FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback

# GitHub App: Metadata read, Contents read/write, Pull requests read/write.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM with newlines encoded as \n when stored in one environment variable.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SETUP_URL=http://localhost:8000/api/v1/github/install/callback

# ----------------------------------------------------------
# Email (SMTP) — Gmail App Password
# ----------------------------------------------------------
# 1. Google Account → Security → 2-Step Verification (required)
# 2. App passwords: https://myaccount.google.com/apppasswords
# 3. Create a password for "Mail". Paste 16 characters with no spaces, or in quotes.
#    Unquoted spaces are truncated (SMTP_PASSWORD=abcd efgh ... becomes "abcd").
# These settings are also used to send account verification and password-reset codes.

SMTP_HOST=smtp.gmail.com

SMTP_PORT=587

SMTP_USERNAME=you@gmail.com

SMTP_PASSWORD=

SMTP_FROM_EMAIL=you@gmail.com

# Render free blocks SMTP ports 25/465/587. Local Gmail SMTP will keep working.
# For the Vercel app, set one HTTPS provider on Render (not Vercel):
# RESEND_API_KEY=re_...
# SENDGRID_API_KEY=SG....

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------

# Comma-separated URLs (Render). Example:
# BACKEND_CORS_ORIGINS=https://your-app.vercel.app
# Or JSON: ["https://your-app.vercel.app","http://localhost:3000"]
BACKEND_CORS_ORIGINS=http://localhost:3000,https://localhost:3000
